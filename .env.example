# OLUMIDE FILMS — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# All variables below are server-side only (no NEXT_PUBLIC_ prefix).

# Resend transactional email (contact form) — added in Phase 5
RESEND_API_KEY=
# Verified sender address, e.g. "OLUMIDE FILMS <hello@olumidefilms.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives project inquiries
CONTACT_TO_EMAIL=
